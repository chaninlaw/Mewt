# macOS
.DS_Store

# Xcode user-specific state
xcuserdata/

# Xcode CLI build artifacts (when scheme isn't shared, xcodebuild
# drops outputs into ./build/ instead of DerivedData)
build/

# Python (asset pipeline)
__pycache__/
*.pyc

# App Store screenshots (large; regenerated via scripts/screenshots.sh)
tasks/screenshots/

# Local debug scripts & outputs
scripts/debug/

# Local tooling / Xcode Cloud workspace metadata
t3.json
Mewt.xcodeproj/xcshareddata/xcodecloud/
